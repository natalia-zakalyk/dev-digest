new file mode 100644
--- /dev/null
+++ b/src/pricing/discount.ts
@@ -0,0 +1,22 @@
+export interface Order {
+  subtotal: number;
+  couponCode?: string;
+  isFirstOrder: boolean;
+}
+
+/** Discount in cents. Orders of 100.00 or more get 10 %; first orders get 5.00 off. */
+export function discountFor(order: Order): number {
+  if (order.subtotal <= 0) {
+    throw new Error('Subtotal must be positive');
+  }
+  let discount = 0;
+  if (order.subtotal >= 10_000) {
+    discount += Math.round(order.subtotal * 0.1);
+  }
+  if (order.isFirstOrder) {
+    discount += 500;
+  }
+  if (order.couponCode === 'STAFF') {
+    discount = order.subtotal;
+  }
+  return Math.min(discount, order.subtotal);
+}
